{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobiPOS PDA",
  "version": "0.1.0",
  "identifier": "com.globipos.pda",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GlobiPOS PDA",
        "url": "https://globipos.shop/pda/",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 24
    }
  }
}
